<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#111111">
  <title>Moto-Agent</title>
  <link rel="manifest" href="manifest.webmanifest">
  <link rel="icon" href="assets/icon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <main id="app" class="ride-shell" data-risk="idle">
    <header class="top-bar">
      <div>
        <p class="eyebrow">MOTO-AGENT</p>
        <h1>Edge Ride OS</h1>
      </div>
      <button id="permissionButton" class="pill-button primary" type="button">啟動感測器</button>
    </header>

    <section class="ride-canvas" aria-label="riding dashboard">
      <div class="map-grid" aria-hidden="true"></div>
      <div class="route-line" aria-hidden="true"></div>

      <div class="nav-card">
        <div class="turn-sign">↱</div>
        <div>
          <p id="gpsState">GPS 待命</p>
          <input id="destinationInput" class="destination-input" type="text" inputmode="text" autocomplete="off" placeholder="輸入目的地">
        </div>
      </div>

      <div class="function-row" aria-label="mount and calibration controls">
        <div class="segmented-control" role="group" aria-label="手機固定位置">
          <button class="mount-button active" type="button" data-mount="handlebar">龍頭</button>
          <button class="mount-button" type="button" data-mount="tank">油箱</button>
        </div>
        <button id="calibrateButton" class="pill-button" type="button" disabled>歸零校正</button>
      </div>

      <section class="speed-stage" aria-label="speed">
        <div class="speed-readout">
          <output id="speed">--</output>
          <span>KM/H</span>
        </div>
        <div class="speed-bar" aria-hidden="true">
          <span id="speedBar"></span>
        </div>
      </section>

      <section class="risk-card" aria-live="polite">
        <h2 id="riskTitle">尚未啟動</h2>
      </section>
    </section>

    <section class="metrics-grid" aria-label="sensor metrics">
      <article class="metric">
        <span>傾角</span>
        <strong id="roll">--</strong>
        <small>deg</small>
      </article>
      <article id="jerkMetric" class="metric" data-jerk-zone="calm">
        <span>Jerk</span>
        <strong id="jerk">--</strong>
        <small>m/s³</small>
      </article>
    </section>

    <nav class="bottom-nav" aria-label="quick actions">
      <button class="nav-icon-button" type="button" aria-label="音樂">
        <svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24">
          <path d="M9 18.5A2.5 2.5 0 1 1 7.5 16.2V6.1L18 4v10.5a2.5 2.5 0 1 1-1.5-2.3V7.3l-7 1.4v9.8z"/>
        </svg>
      </button>
      <button class="nav-icon-button" type="button" aria-label="電話">
        <svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24">
          <path d="M6.7 4.4 9 6.7c.6.6.7 1.5.3 2.2l-.8 1.3a11.6 11.6 0 0 0 5.3 5.3l1.3-.8c.7-.4 1.6-.3 2.2.3l2.3 2.3c.6.6.6 1.5.1 2.1-.9 1.1-2.4 1.6-3.8 1.2A17.9 17.9 0 0 1 3.4 8.1c-.4-1.4.1-2.9 1.2-3.8.6-.5 1.5-.5 2.1.1z"/>
        </svg>
      </button>
    </nav>
  </main>

  <script>
    if ("serviceWorker" in navigator) {
      let refreshing = false;
      navigator.serviceWorker.addEventListener("controllerchange", () => {
        if (refreshing) return;
        refreshing = true;
        window.location.reload();
      });

      window.addEventListener("load", async () => {
        try {
          const registration = await navigator.serviceWorker.register("./service-worker.js");
          await registration.update();
        } catch {}
      });
    }
  </script>
  <script type="module" src="app.js"></script>
</body>
</html>
